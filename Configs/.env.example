# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/social_media_automation
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# External APIs (Future)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# AI Services (Optional)
OPENAI_API_KEY=
CLAUDE_API_KEY=

# Facebook/Instagram posting (Meta Graph API) — leave blank for dry-run mode
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# WhatsApp Bot (Meta Cloud API) — leave blank to run in dry-run/log-only mode
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-string-and-reuse-it-in-the-meta-dashboard
